{
  // The name is set per pull request by `wrangler deploy --name`, and the
  // variables by `--var`: see .github/workflows/vite-app-preview.yml.
  "name": "maple-example",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist-preview",
    "binding": "ASSETS",
    // The Worker answers these before an asset can: the route and the page's API.
    "run_worker_first": ["/api/*", "/ld/*"],
  },
}
