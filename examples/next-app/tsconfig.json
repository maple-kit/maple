{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "react"],
    "jsx": "preserve",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "instrumentation-client.ts"
  ]
}
