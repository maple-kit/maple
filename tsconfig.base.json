{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@maple-kit/core": ["./packages/core/src/index.ts"],
      "@maple-kit/core/anchor": ["./packages/core/src/anchor/index.ts"],
      "@maple-kit/core/connectors": ["./packages/core/src/connectors/index.ts"],
      "@maple-kit/core/export": ["./packages/core/src/export/index.ts"],
      "@maple-kit/core/logger": ["./packages/core/src/logger/index.ts"],
      "@maple-kit/core/config": ["./packages/core/src/config/index.ts"],
      "@maple-kit/core/overlay": ["./packages/core/src/overlay/index.ts"],
      "@maple-kit/core/tagger": ["./packages/core/src/tagger/index.ts"],
      "@maple-kit/core/testing": ["./packages/core/src/testing/index.ts"],
      "@maple-kit/cli": ["./packages/cli/src/index.ts"],
      "@maple-kit/mcp": ["./packages/mcp/src/index.ts"]
    }
  }
}
