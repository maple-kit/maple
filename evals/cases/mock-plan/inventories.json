{
  "vite-overview": {
    "source": "recorded",
    "route": "/",
    "calls": [
      {
        "key": "rest:GET /api/reviews",
        "summary": "items [Review: id, repo, branch, open, state, reviewer, tint], total, nextCursor"
      },
      {
        "key": "rest:GET /api/session",
        "summary": "name, tint"
      }
    ]
  },
  "next-projects": {
    "source": "recorded",
    "route": "/",
    "calls": [
      {
        "key": "trpc:project.slow",
        "summary": "waitedMs"
      },
      {
        "key": "trpc:project.count",
        "summary": ""
      },
      {
        "key": "trpc:project.list",
        "summary": "items [Project: id, name, owner, createdAt], total, nextCursor"
      },
      {
        "key": "trpc:user.me",
        "summary": "User: id, name, since"
      }
    ]
  },
  "roastery-dashboard": {
    "source": "written",
    "route": "/dashboard",
    "calls": [
      {
        "key": "trpc:user.me",
        "summary": "User: id, name, email, role, roasteryId"
      },
      {
        "key": "trpc:roast.list",
