      },
      {
        "key": "trpc:roast.overTimeSparkline",
        "summary": "list of [day, count]"
      },
      {
        "key": "trpc:origin.top",
        "summary": "list of [Origin: id, country, region, roastCount]"
      },
      {
        "key": "trpc:bean.listLowStock",
        "summary": "items [Bean: id, name, origin, stockKg, reorderAtKg], totalCount"
      },
      {
        "key": "trpc:order.list",
        "summary": "items [Order: id, cafeName, status, placedAt, totalKg], nextCursor, hasMore"
      },
      {
        "key": "trpc:notification.unreadCount",
        "summary": "count"
      },
      {
        "key": "trpc:roast.create",
        "summary": "Roast: id, beanName, status"
      },
      {
        "key": "trpc:order.markShipped",
        "summary": "Order: id, status"
      }
    ],
    "flags": [
      {
        "key": "new-roast-planner",
        "type": "boolean"
      },
      {
        "key": "ROAST-2210-sparkline-tooltips",
        "type": "boolean"
      },
      {
        "key": "originMapV2",
        "type": "boolean"
      },
      {
        "key": "low-stock-banner",
        "type": "boolean"
      },
      {
        "key": "dashboard-density",
        "type": "string",
        "variants": ["compact", "comfortable"]
      },
      {
        "key": "order-list-page-size",
        "type": "number",
        "variants": [10, 25, 50]
      },
      {
        "key": "wholesale-portal",
        "type": "boolean"
      },
      {
        "key": "notification-digest",
        "type": "string",
        "variants": ["off", "daily", "weekly"]
      },
      {
        "key": "cupping-shortcut-beta",
        "type": "boolean"
      },
      {
        "key": "green-bean-forecast",
        "type": "boolean"
      },
      {
        "key": "shipping-labels-beta",
        "type": "boolean"
      },
      {
        "key": "theme",
        "type": "string",
        "variants": ["light", "dark", "roastery"]
      }
    ],
    "roles": ["owner", "head-roaster", "roaster", "barista", "wholesale-buyer", "viewer"]
  },
