# Exact versions only. A range means the tree can change without a commit.
save-exact=true

# The public registry, explicitly. A machine whose global ~/.npmrc points at a
# company mirror would otherwise resolve and publish there, and the failure is
# silent: npm reports success against whichever registry it happened to use.
# Behind a mirror that is the only reachable one, override for the install with
# `NPM_CONFIG_REGISTRY=<mirror> pnpm install` — an environment variable outranks
# this file, and the lockfile job in CI catches a mirror URL if one gets in.
registry=https://registry.npmjs.org/

# Refuse to install on an unsupported Node rather than failing later, oddly.
# It cannot catch every one: pnpm 10 and 11 load `node:sqlite` at startup, so on
# Node 23 pnpm dies before reading this. CONTRIBUTING.md names that error.
engine-strict=true
strict-ssl=true

# No package runs code at install time. This is the single highest-value
# supply-chain control available here, and the cost is that the repository's own
# `prepare` does not run either: install the git hooks with `pnpm hooks`.
ignore-scripts=true

# Provenance needs a CI publish with `id-token: write`, which is what
# .github/workflows/release.yml is. A publish from a laptop cannot attest and
# npm refuses the flag there, which is deliberate: releases come from CI.
provenance=true
