# Exact versions only. A range means the tree can change without a commit.
save-exact=true

# Refuse to install on an unsupported Node rather than failing later, oddly.
# It cannot catch every one: pnpm 10 and 11 load `node:sqlite` at startup, so on
# Node 23 pnpm dies before reading this. CONTRIBUTING.md names that error.
engine-strict=true
strict-ssl=true

# No package runs code at install time. This is the single highest-value
# supply-chain control available here, and the cost is that the repository's own
# `prepare` does not run either: install the git hooks with `pnpm hooks`.
ignore-scripts=true

provenance=true
