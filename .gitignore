# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-preview/
build/
*.tsbuildinfo
.next/
.next-preview/
.next-strip/
.turbo/

# secrets — never commit a credential value
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12

# Maple local artifacts (screenshots may contain application data)
.maple/shots/

# Owner notes. STATUS.md and setup-owner.md live here: both describe the state
# of this installation — what is registered, what is still open, which gaps are
# unclosed — which is a maintainer's working note and not a published document.
.local/

# Claude Code's per-machine settings. Ignored globally on the maintainer's
# machine, which does nothing for a contributor's.
.claude/settings.local.json

# test and tooling output
coverage/
.vitest/
playwright-report/
test-results/
evals/.evalite/

# editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
